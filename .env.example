# Authentication
# Use demo only during local/staging development. Production must use the real backend login.
VITE_AUTH_MODE=demo

# Local demo remains the default until the shared backend is connected.
VITE_BACKEND_MODE=local

# These will be filled when we connect the Fahrdienst backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
